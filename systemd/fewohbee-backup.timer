# HISTORICAL: FewohBee was retired on 2026-09-27. This unit is not installed
# and does not describe the current deployment; see CODEX_STATE.md.
[Unit]
Description=Daily verified backup of the FewohBee SQLite demo

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
# Runs on the next boot or resume when the machine was off or suspended at 03:30.
Persistent=true

[Install]
WantedBy=timers.target
