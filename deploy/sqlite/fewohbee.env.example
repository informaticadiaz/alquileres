# Copy to ~/.config/fewohbee/fewohbee.env and chmod 600. Never commit the real file.
APP_ENV=sqlite_prod
APP_DEBUG=0
# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=change-me
# Persistent database outside the application checkout.
FEWOHBEE_SQLITE_PATH=/home/USER/.local/share/fewohbee/data/fewohbee.sqlite
# Only the local reverse proxy / tunnel connector (e.g. cloudflared) is trusted.
TRUSTED_PROXIES=127.0.0.1
DEFAULT_URI=https://rentals.example.com
# Disable outgoing e-mail for a demo; configure a real DSN otherwise.
MAIL_ENABLED=false
MAILER_DSN=null://null
